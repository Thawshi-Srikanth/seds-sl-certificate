# Supabase Configuration for Frontend (Safe for client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Domain Configuration
# The platform hosting URL (e.g., https://cert.sedssl.org or http://localhost:3000)
VITE_APP_URL=https://cert.sedssl.org
# Main organization website (e.g., https://sedssl.org)
VITE_ORG_URL=https://sedssl.org

# Optional: Default Event Slug (e.g., imot or observe-the-moon-2026)
VITE_DEFAULT_EVENT_SLUG=imot

# Supabase Edge Functions / Backend only (DO NOT EXPOSE TO FRONTEND)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
